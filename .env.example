# Canonical site origin. Leave blank to use xyro.ai in production and the
# Vercel deployment URL for Preview deployments.
SITE_URL=

# OpenRouter API key. Server-side only; never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Firebase Web configuration. apiKey, authDomain, projectId, and appId are
# required for sign-in/profile storage. databaseURL is required for presence
# and live chat response streams.
# These web config values are public, not privileged.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Use your custom production domain here (for example: app.example.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Copy the database URL from Firebase Console > Realtime Database.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Stored for future consent-based Analytics; Analytics is not initialized yet.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Free-stack integrations for the full product plan. These stay server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary preset must be signed and enforce the documented formats and 10 MB limit.
CLOUDINARY_UPLOAD_PRESET=
KEK_V1=
API_KEY_PEPPER=
DEVICE_HASH_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_CHECK_SITE_KEY=
APP_CHECK_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra hostnames allowed in Turnstile siteverify responses, comma-separated
# (the SITE_URL hostname and the vercel.app alias are always allowed).
TURNSTILE_HOSTNAME_ALLOWLIST=
# Signs the __Host-xyro_session session cookie (HS256). Server-side only.
# Use at least 32 random bytes, e.g. `openssl rand -base64 48`. Never commit
# a real value; sessions cannot be issued while this is missing or short.
SESSION_SECRET=
EMAIL_PROVIDER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Server-side Firebase Admin credentials used to create accounts after Turnstile verification.
# Keep the private key in deployment secrets; encode line breaks as \n in .env files.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Watermarking secrets. Server-side only; never prefix with NEXT_PUBLIC_.
MARK_KEY=
MARK_SERVICE_SECRET=
