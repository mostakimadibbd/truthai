# Canonical site origin. Leave blank to use xyro.ai in production and the
# Vercel deployment URL for Preview deployments.
SITE_URL=

# OpenRouter API key. Server-side only; never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Firebase Web configuration. These values are used by browser Firebase SDKs
# and are public project identifiers, not credentials for privileged access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service-account values. Server-side only.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Watermarking secrets. Server-side only; never prefix with NEXT_PUBLIC_.
MARK_KEY=
MARK_SERVICE_SECRET=
