rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ]);
    }

    function hasValidProfile(userId) {
      let profile = request.resource.data;
      return hasOnlyProfileFields()
        && profile.uid == userId
        && profile.email is string
        && profile.email == request.auth.token.get('email', '')
        && profile.displayName is string
        && profile.displayName.size() <= 100
        && profile.photoURL is string
        && profile.photoURL.size() <= 2048
        && profile.createdAt is timestamp
        && profile.updatedAt is timestamp
        && profile.lastSignInAt is timestamp;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;
      allow create: if ownsUser(userId)
        && hasValidProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSignInAt == request.time;
      allow update: if ownsUser(userId)
        && hasValidProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'updatedAt',
          'lastSignInAt'
        ]);
      allow delete: if false;
    }

    match /users/{userId}/chats/{chatId} {
      allow read: if ownsUser(userId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/uploads/{assetId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
