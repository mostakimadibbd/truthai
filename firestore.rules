rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ]);
    }

    function hasValidProfile(userId) {
      let profile = request.resource.data;
      return hasOnlyProfileFields()
        && profile.uid == userId
        && profile.email is string
        && profile.email == request.auth.token.get('email', '')
        && profile.displayName is string
        && profile.displayName.size() <= 100
        && profile.photoURL is string
        && profile.photoURL.size() <= 2048
        && profile.createdAt is timestamp
        && profile.updatedAt is timestamp
        && profile.lastSignInAt is timestamp;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;
      // Phase 9 audit: profiles are created and updated ONLY by the
      // server (sign-up / session routes create them; Settings →
      // Profile updates them via /api/settings/profile, including the
      // validated Cloudinary avatar pipeline). All client profile
      // writes were removed in Phase 2, so direct client writes are
      // denied outright — a client can no longer set an arbitrary
      // photoURL/displayName by talking to Firestore directly. The
      // hasValidProfile helpers above are now unused and are kept
      // only as a record of the previous validation.
      allow create, update, delete: if false;
    }

    match /users/{userId}/chats/{chatId} {
      allow read: if ownsUser(userId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/uploads/{assetId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Settings preferences (Phase 3): written only by the server via
    // /api/settings; owners may read their own document so the chat
    // workspace can react to preference changes live.
    match /users/{userId}/settings/{document} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Session records (Phase 3): created and revoked only by the
    // server; owners may read their own list for display fallback.
    match /users/{userId}/sessions/{sessionId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
