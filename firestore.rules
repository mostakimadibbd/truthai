rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt',
          'lastSignInAt'
        ]);
    }

    function hasValidProfile(userId) {
      let profile = request.resource.data;
      return hasOnlyProfileFields()
        && profile.uid == userId
        && profile.email is string
        && profile.email == request.auth.token.get('email', '')
        && profile.displayName is string
        && profile.displayName.size() <= 100
        && profile.photoURL is string
        && profile.photoURL.size() <= 2048
        && profile.createdAt is timestamp
        && profile.updatedAt is timestamp
        && profile.lastSignInAt is timestamp;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;
      // Phase 9 audit: profiles are created and updated ONLY by the
      // server (sign-up / session routes create them; Settings →
      // Profile updates them via /api/settings/profile, including the
      // validated Cloudinary avatar pipeline). All client profile
      // writes were removed in Phase 2, so direct client writes are
      // denied outright — a client can no longer set an arbitrary
      // photoURL/displayName by talking to Firestore directly. The
      // hasValidProfile helpers above are now unused and are kept
      // only as a record of the previous validation.
      allow create, update, delete: if false;
    }

    match /users/{userId}/chats/{chatId} {
      allow read: if ownsUser(userId);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if ownsUser(userId);
        allow write: if false;
      }
    }

    match /users/{userId}/uploads/{assetId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Settings preferences (Phase 3): written only by the server via
    // /api/settings; owners may read their own document so the chat
    // workspace can react to preference changes live.
    match /users/{userId}/settings/{document} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Session records (Phase 3): created and revoked only by the
    // server; owners may read their own list for display fallback.
    match /users/{userId}/sessions/{sessionId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Device registry: one document per browser fingerprint the
    // account has signed in from. Written only by the server at
    // login; owners may read their own list.
    match /users/{userId}/devices/{deviceId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Security activity feed: sign-in / sign-up / new-device /
    // velocity events, appended only by the server at login.
    match /users/{userId}/securityEvents/{eventId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Sign-up velocity counters per device fingerprint: server-only,
    // never readable or writable by clients.
    match /deviceSignals/{deviceId} {
      allow read, write: if false;
    }

    // Developer platform: activation profile, API key records (hash
    // only — the full key is never stored), daily usage rollups and
    // per-request fingerprint events. All written by the server;
    // owners may read their own data for display fallback.
    match /users/{userId}/developerProfile/{document} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/apiKeys/{keyId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/apiUsage/{date} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/apiEvents/{eventId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/apiModelUsage/{document} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/apiAccessPoints/{document} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // API key auth lookup (key hash -> owner): server-only, never
    // readable or writable by clients.
    match /apiKeys/{keyHash} {
      allow read, write: if false;
    }

    // The user's own chat metering (written by the server; the
    // Usage tab reads it through the API).
    match /users/{userId}/chatUsage/{date} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Per-conversation daily chat metering (Usage tab's
    // "today by chat" breakdown; server-written).
    match /users/{userId}/chatUsageByDay/{date}/chats/{chatId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    // Platform analytics: per-request token ledger and the
    // per-minute / per-day rollups. Administrator-only data —
    // no client may read or write any of it; the admin console
    // reads it through the server (Admin SDK bypasses rules).
    match /usageEvents/{eventId} {
      allow read, write: if false;
    }
    // Web-search activity log (query, trigger, provider, result
    // count, sources). Server-written only; no client access.
    match /searchEvents/{eventId} {
      allow read, write: if false;
    }
    match /analytics_minutes/{minute} {
      allow read, write: if false;
    }
    match /analytics_days/{day} {
      allow read, write: if false;
    }
    match /analytics_model_minutes/{document} {
      allow read, write: if false;
    }
    match /analytics_model_days/{document} {
      allow read, write: if false;
    }
    match /analytics_user_days/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
